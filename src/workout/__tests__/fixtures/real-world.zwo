<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
    <author>Zwift</author>
    <name>The Gorby</name>
    <description>A tough sweet spot session with over-unders.</description>
    <sportType>bike</sportType>
    <durationType>time</durationType>
    <tags>
        <tag name="INTERVALS"/>
    </tags>
    <workout>
        <Warmup Duration="480" PowerLow="0.25" PowerHigh="0.75" pace="0">
            <textevent timeoffset="0" message="Welcome to The Gorby!"/>
        </Warmup>
        <SteadyState Duration="120" Power="0.65" pace="0"/>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.05" OffPower="0.85" pace="0"/>
        <SteadyState duration="300" power="0.55" pace="0"/>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.05" OffPower="0.85" pace="0"/>
        <Cooldown Duration="480" PowerLow="0.75" PowerHigh="0.25" pace="0"/>
    </workout>
</workout_file>
